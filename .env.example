# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (Neon). Runtime uses the pooler; migrations use the direct URL.
# Tests set DB_CONNECTION=sqlite in .env.test (file in tmp/), so they need
# no Postgres; DATABASE_URL* there are placeholders.
# DB_CONNECTION=postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# IAM (OAuth 2.0 / OIDC). IAM runs on 3333 locally, so run Share on another PORT.
# Register IAM_REDIRECT_URI (and the post-logout URI) on Share's OAuth client in IAM.
IAM_ISSUER=http://localhost:3333
IAM_CLIENT_ID=
IAM_CLIENT_SECRET=
IAM_REDIRECT_URI=${APP_URL}/auth/iam/callback
IAM_POST_LOGOUT_REDIRECT_URI=${APP_URL}/login
