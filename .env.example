# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database (Neon). Runtime uses the pooler; migrations use the direct URL.
# Tests set DB_CONNECTION=sqlite in .env.test (file in tmp/), so they need
# no Postgres; DATABASE_URL* there are placeholders.
# DB_CONNECTION=postgres
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# IAM (OAuth 2.0 / OIDC). IAM runs on 3333 locally, so run Share on another PORT.
# Register IAM_REDIRECT_URI (and the post-logout URI) on Share's OAuth client in IAM.
IAM_ISSUER=http://localhost:3333
IAM_CLIENT_ID=
IAM_CLIENT_SECRET=
IAM_REDIRECT_URI=${APP_URL}/auth/iam/callback
IAM_POST_LOGOUT_REDIRECT_URI=${APP_URL}/login
# How often (seconds) a signed-in user's Share access and role are re-checked
# with IAM via the refresh token; losing access signs them out.
IAM_RECHECK_SECONDS=300

# Object storage (Cloudflare R2, S3 API). Bytes never pass through Share:
# browsers PUT/GET via presigned URLs. Tests use DRIVE_DISK=fs (.env.test).
# Check the setup with `node ace storage:probe`.
# The bucket's CORS policy must allow PUT from APP_URL (browser uploads from
# /transfers/new), e.g. on R2:
#   [{ "AllowedOrigins": ["http://localhost:3334"], "AllowedMethods": ["PUT", "GET"],
#      "AllowedHeaders": ["Content-Type"], "MaxAgeSeconds": 3600 }]
DRIVE_DISK=r2
# https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
STORAGE_UPLOAD_URL_TTL=1h
STORAGE_DOWNLOAD_URL_TTL=5m
# Single-PUT cap. R2 documents 5 GiB - 5 MiB (5363466240) for one-part
# uploads, below S3's 5 GiB; this is the default when unset. Not yet
# measured against the real bucket (multipart is out of scope).
STORAGE_MAX_SINGLE_PUT_BYTES=5363466240

# Queue. Jobs and schedules are stored in Postgres (queue_jobs,
# queue_schedules). Run the worker with `pnpm worker`; the web server
# registers the schedules (transfer cleanup every 15 min) when it boots.
QUEUE_DRIVER=database

# Rate limits (downloads, transfer creation, wrong passwords). Counters are
# stored in Postgres (rate_limits table) so all replicas share them.
LIMITER_STORE=database

# Mail. When MAIL_ENABLED=true the queue worker sends: a notice to recipients
# when a transfer's uploads are first confirmed, a receipt to the creator on
# each recipient's first download, and an hourly "expires within 24h" reminder
# to recipients who haven't downloaded yet. Leave false to send nothing.
MAIL_ENABLED=false
# zeptomail (ZeptoMail HTTP API, production) or smtp (e.g. a local Mailpit).
MAIL_MAILER=smtp
# Must be on a domain verified in the ZeptoMail Mail Agent.
MAIL_FROM_ADDRESS=share@digitalcovet.com
MAIL_FROM_NAME=CovetDrop
# ZeptoMail: the Mail Agent's send-mail token (with or without the
# "Zoho-enczapikey " prefix) and the API endpoint of the account's data center.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_URL=https://cpaas.zoho.in/v1.1/email
# SMTP (only when MAIL_MAILER=smtp).
SMTP_HOST=
SMTP_PORT=587
# true for implicit TLS (port 465); STARTTLS on 587 is negotiated automatically.
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
