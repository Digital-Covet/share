SESSION_DRIVER=memory

# Tests run against a SQLite file (tmp/db.test.sqlite3), not Postgres.
# The Postgres URLs are required by start/env.ts but never connected to.
DB_CONNECTION=sqlite
DATABASE_URL=postgresql://unused@localhost/unused
DATABASE_URL_UNPOOLED=postgresql://unused@localhost/unused

APP_KEY=test-app-key-not-secret-0123456789ab

# Dummy IAM client; tests never reach IAM.
IAM_ISSUER=http://localhost:3999
IAM_CLIENT_ID=test
IAM_CLIENT_SECRET=
IAM_REDIRECT_URI=http://localhost:3334/auth/iam/callback
IAM_RECHECK_SECONDS=300

# Local disk under tmp/drive; presigned URLs are stand-ins (config/drive.ts).
DRIVE_DISK=fs
STORAGE_UPLOAD_URL_TTL=1h
STORAGE_DOWNLOAD_URL_TTL=5m
STORAGE_MAX_SINGLE_PUT_BYTES=5363466240

# Dispatched jobs run inline; no worker in tests.
QUEUE_DRIVER=sync

# Per-process rate-limit counters.
LIMITER_STORE=memory

# Notifications off, so tests never reach SMTP; notify.spec.ts turns them
# on around `mail.fake()`.
MAIL_ENABLED=false
MAIL_FROM_ADDRESS=share@example.com
SMTP_HOST=localhost
SMTP_PORT=2525
